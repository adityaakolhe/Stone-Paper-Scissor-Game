import random

items = ["Stone", "Paper", "Scissor"]

user_score = 0
computer_score = 0

for round_number in range(1, 4):
    print(f"\n--- Round {round_number} ---")
    computer = random.choice(items)
    user = input("Enter your choice: ").strip().capitalize()

    if computer == user:
        print("MATCH TIEE!!")

    elif (computer == "Stone" and user == "Paper") or \
         (computer == "Scissor" and user == "Stone") or \
         (computer == "Paper" and user == "Scissor"):
        print("yehh, YOU WONNN!!!")
        print("computers choice:", computer)
        user_score += 1

    else:
        print("YOU LOSE!!")
        print("computers choice:", computer)
        computer_score += 1

print("\n===== FINAL RESULT =====")
print(f"Your score: {user_score}")
print(f"Computer's score: {computer_score}")

if user_score > computer_score:
    print("Overall, YOU WIN THE GAME!! 🎉")
elif computer_score > user_score:
    print("Overall, COMPUTER WINS!! 😢")
else:
    print("Overall, IT'S A TIE!!")